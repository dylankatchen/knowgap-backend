# Demo Environment Configuration
# Copy these values to .env for local demo data generation

# Database (use your actual MongoDB connection string)
DB_CONNECTION_STRING=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/your-database

# Encryption key for Canvas tokens (32-byte hex key)
HEX_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# OpenAI API key (for AI features - optional for demo)
OPENAI_KEY=sk-your-openai-api-key-here

# YouTube API key (for video features - optional for demo)
YOUTUBE_API_KEY=your-youtube-api-key-here

# JWT Secret
ACHIEVEUP_JWT_SECRET=your-super-secret-jwt-key-for-development

# Canvas URLs.
CANVAS_DOMAIN=canvas.instructure.com

# URL for the AchieveUp frontend.
FRONTEND_URL=https://achieveupapp.com
FRONTEND_HOSTING_URL=https://achieveup.netlify.app

# Environment
ENVIRONMENT=development

# Database name
DATABASE=KnowGap
